{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "card": {
      "type": "object",
      "properties": {
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reasoning",
        "workflow",
        "strategy"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          }
        },
        "required": [
          "model",
          "effort"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "card",
    "policy"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-arena:competitor:1",
  "title": "Codex Arena competitor v1"
}
