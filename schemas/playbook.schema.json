{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arena immutable signed playbook payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "version", "files", "rules", "tiers", "provenance", "model_policy", "generation_id", "available_plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "description": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "available_plugins": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "main_path", "sha256"], "properties": {"name": {"type": "string"}, "main_path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "model_policy": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["model", "effort"], "properties": {"model": {"type": "string", "minLength": 1}, "effort": {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]}}}},
    "rules": {"type": "object", "additionalProperties": false, "required": ["min_holdout", "repetitions", "quality_gain", "resource_gain"], "properties": {"min_holdout": {"type": "integer", "minimum": 1}, "repetitions": {"type": "integer", "minimum": 1}, "quality_gain": {"type": "number", "minimum": 0}, "resource_gain": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}}},
    "tiers": {"type": "object", "additionalProperties": false, "required": ["iron", "copper", "silver", "gold"], "properties": {"iron": {"$ref": "#/$defs/tier"}, "copper": {"$ref": "#/$defs/tier"}, "silver": {"$ref": "#/$defs/tier"}, "gold": {"$ref": "#/$defs/tier"}}},
    "provenance": {"type": "object", "required": ["schema_version", "purpose", "key_id", "payload", "signature"], "properties": {"purpose": {"const": "tournament-source"}}}
  },
  "$defs": {"tier": {"type": "object", "additionalProperties": false, "required": ["candidate_hash", "validation"], "properties": {"candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "validation": {"type": "object", "required": ["required", "storage"], "properties": {"required": {"const": true}, "storage": {"const": "workspace-local-signed-evidence"}}}}}}
}
